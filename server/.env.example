PORT=3000
# Frontend URL (allowed CORS origin)
ClientHostName=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string

# MySQL
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
