# Max number of files per upload
maxAllowedFiles=10

# AWS S3 / CloudFront
BUCKET_NAME=
BUCKET_REGION=
ACCESS_KEY=
SECRET_ACCESS_KEY=
# Must end with /, e.g. https://xxxx.cloudfront.net/
CLOUDFRONT_URL=
